{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/held_merge.py\" record || python \"${CLAUDE_PLUGIN_ROOT}/hooks/held_merge.py\" record", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [ { "type": "command", "if": "Bash(gh pr merge*)", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/held_merge.py\" check || python \"${CLAUDE_PLUGIN_ROOT}/hooks/held_merge.py\" check", "timeout": 40 } ]
      }
    ]
  }
}
