#!/usr/bin/env bash
# pre-commit: staged-set mirror of check_sync_rule (tests/validate.sh).
# Same trigger as the suite: if the STAGED set touches the workflow doc,
# README.md must be staged too, else block. Local guardrail — bypass with
# `git commit --no-verify`.
set -uo pipefail
DOC=docs/engineering-workflow.md
files=$(git diff --cached --name-only)
grep -qxF "$DOC" <<<"$files" || exit 0
grep -qxF README.md <<<"$files" && exit 0
echo "pre-commit: sync rule — staging $DOC requires README.md staged too. Bypass: git commit --no-verify"
exit 1
